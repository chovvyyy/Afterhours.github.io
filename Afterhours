<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Afterhours — A virtual sales rep for car dealerships</title>
<meta name="description" content="Afterhours is a virtual sales rep for car dealerships. It takes calls 24/7, works through your inventory, books test drives, and never misses a lead.">
<meta name="theme-color" content="#0a0c10">
<meta property="og:title" content="Afterhours — A virtual sales rep for car dealerships">
<meta property="og:description" content="Takes calls 24/7. Knows your inventory. Books test drives. Never sleeps.">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><circle cx=%2216%22 cy=%2216%22 r=%228%22 fill=%22%23f59e3c%22/></svg>">

<style>
/* ============================================================
   Design tokens — dark default, light optional via [data-theme]
   ============================================================ */
:root,
[data-theme="dark"] {
  --bg: #0a0c10;
  --bg-elevated: #11141a;
  --surface: #161a22;
  --surface-2: #1c212b;
  --border: #232934;
  --border-strong: #2e3543;
  --text: #ebecee;
  --text-muted: #8a909a;
  --text-dim: #5a606b;
  --accent: #f59e3c;
  --accent-hover: #fbb058;
  --accent-soft: rgba(245, 158, 60, 0.12);
  --accent-border: rgba(245, 158, 60, 0.25);
  --success: #4ade80;
  --shadow: 0 1px 2px rgba(0,0,0,0.4), 0 8px 24px rgba(0,0,0,0.25);
  --nav-bg: rgba(10, 12, 16, 0.72);
}

[data-theme="light"] {
  --bg: #faf9f6;
  --bg-elevated: #ffffff;
  --surface: #f3f1ec;
  --surface-2: #ebe9e2;
  --border: #e2dfd6;
  --border-strong: #d2cec3;
  --text: #14171c;
  --text-muted: #5a606b;
  --text-dim: #8a909a;
  --accent: #c2410c;
  --accent-hover: #9a330a;
  --accent-soft: rgba(194, 65, 12, 0.08);
  --accent-border: rgba(194, 65, 12, 0.2);
  --success: #16a34a;
  --shadow: 0 1px 2px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06);
  --nav-bg: rgba(250, 249, 246, 0.78);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
*::selection { background: var(--accent); color: var(--bg); }

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}

body {
  background: var(--bg);
  color: var(--text);
  font-family: 'IBM Plex Sans', system-ui, sans-serif;
  font-size: 16px;
  line-height: 1.6;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
  transition: background-color 0.25s ease, color 0.25s ease;
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    transition-duration: 0.01ms !important;
  }
  html { scroll-behavior: auto; }
}

/* Reusable */
.container { max-width: 1200px; margin: 0 auto; padding: 0 28px; }
.eyebrow {
  font-family: 'JetBrains Mono', ui-monospace, monospace;
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
}
.eyebrow::before {
  content: "";
  display: inline-block;
  width: 28px;
  height: 1px;
  background: var(--accent);
}
h1, h2, h3, h4 {
  font-family: 'Fraunces', Georgia, serif;
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.1;
}
h2 { font-size: clamp(28px, 3.6vw, 44px); margin-bottom: 18px; }
h3 { font-size: 20px; letter-spacing: -0.01em; }

a { color: inherit; text-decoration: none; }

/* ============================================================
   NAV — sticky with backdrop blur
   ============================================================ */
.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  padding: 14px 0;
  background: var(--nav-bg);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
  border-bottom: 1px solid transparent;
  transition: border-color 0.25s ease;
}
.nav.scrolled { border-bottom-color: var(--border); }
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand {
  font-family: 'JetBrains Mono', monospace;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.08em;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--text);
}
.brand-dot {
  width: 8px;
  height: 8px;
  background: var(--accent);
  border-radius: 50%;
}
.nav-links {
  display: flex;
  gap: 32px;
  font-size: 14px;
  color: var(--text-muted);
}
.nav-links a {
  transition: color 0.15s ease;
  font-weight: 500;
}
.nav-links a:hover { color: var(--text); }

.nav-actions { display: flex; align-items: center; gap: 14px; }

.theme-toggle {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text);
  width: 36px;
  height: 36px;
  border-radius: 8px;
  cursor: pointer;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transition: border-color 0.15s ease, background-color 0.15s ease;
}
.theme-toggle:hover { border-color: var(--border-strong); background: var(--surface); }
.theme-toggle svg { width: 16px; height: 16px; }
[data-theme="dark"] .theme-toggle .sun { display: block; }
[data-theme="dark"] .theme-toggle .moon { display: none; }
[data-theme="light"] .theme-toggle .sun { display: none; }
[data-theme="light"] .theme-toggle .moon { display: block; }

.btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  border-radius: 8px;
  font-family: 'IBM Plex Sans', sans-serif;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: 0.01em;
  cursor: pointer;
  border: none;
  text-decoration: none;
  transition: transform 0.12s ease, background-color 0.15s ease, border-color 0.15s ease;
}
.btn-primary {
  background: var(--accent);
  color: #0a0c10;
}
.btn-primary:hover { background: var(--accent-hover); transform: translateY(-1px); }
.btn-secondary {
  background: transparent;
  border: 1px solid var(--border-strong);
  color: var(--text);
}
.btn-secondary:hover { background: var(--surface); border-color: var(--text-dim); }
.btn-lg { padding: 14px 24px; font-size: 15px; }

/* ============================================================
   HERO
   ============================================================ */
.hero {
  padding: 160px 0 90px;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: "";
  position: absolute;
  top: 0; left: 50%;
  transform: translateX(-50%);
  width: 800px;
  height: 600px;
  background: radial-gradient(ellipse at center top, var(--accent-soft) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}
.hero-content { position: relative; z-index: 1; }
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 6px 14px;
  border: 1px solid var(--accent-border);
  background: var(--accent-soft);
  border-radius: 100px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--accent);
  letter-spacing: 0.04em;
  margin-bottom: 28px;
  opacity: 0;
  animation: fadeUp 0.6s ease 0.1s forwards;
}
.hero-tag .pulse-dot {
  width: 6px; height: 6px;
  background: var(--accent);
  border-radius: 50%;
  position: relative;
}
.hero-tag .pulse-dot::after {
  content: "";
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 2s ease-out infinite;
}
.hero h1 {
  font-size: clamp(42px, 6vw, 76px);
  line-height: 1.02;
  letter-spacing: -0.028em;
  max-width: 920px;
  margin-bottom: 26px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.2s forwards;
}
.hero h1 em {
  font-style: italic;
  color: var(--accent);
  font-weight: 400;
}
.hero-sub {
  font-size: 19px;
  line-height: 1.6;
  color: var(--text-muted);
  max-width: 620px;
  margin-bottom: 40px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.3s forwards;
}
.hero-cta-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16px;
  margin-bottom: 64px;
  opacity: 0;
  animation: fadeUp 0.7s ease 0.4s forwards;
}
.hero-note {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-muted);
  margin-left: 4px;
}

.hero-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  padding: 28px 0;
  border-top: 1px solid var(--border);
  opacity: 0;
  animation: fadeUp 0.7s ease 0.5s forwards;
}
.metric { padding: 0 28px; border-right: 1px solid var(--border); }
.metric:first-child { padding-left: 0; }
.metric:last-child { border-right: none; padding-right: 0; }
.metric-value {
  font-family: 'Fraunces', serif;
  font-size: 36px;
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--text);
  line-height: 1;
  margin-bottom: 8px;
}
.metric-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-muted);
}

/* ============================================================
   SECTION SHARED
   ============================================================ */
section { padding: 100px 0; }
.section-head {
  max-width: 720px;
  margin-bottom: 60px;
}
.section-head p {
  color: var(--text-muted);
  font-size: 17px;
  margin-top: 14px;
  max-width: 580px;
}

/* ============================================================
   FEATURES GRID
   ============================================================ */
.features { border-top: 1px solid var(--border); }
.features-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--border);
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
}
.feature-card {
  background: var(--bg);
  padding: 36px 32px;
  position: relative;
  transition: background-color 0.2s ease;
}
.feature-card:hover { background: var(--surface); }
.feature-icon {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--accent-soft);
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 22px;
  border: 1px solid var(--accent-border);
}
.feature-icon svg { width: 20px; height: 20px; }
.feature-card h3 { margin-bottom: 10px; color: var(--text); }
.feature-card p {
  color: var(--text-muted);
  font-size: 15px;
  line-height: 1.6;
}

/* ============================================================
   HOW IT WORKS — interactive stepper
   ============================================================ */
.how { border-top: 1px solid var(--border); }
.stepper-shell {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
}
.stepper-rail {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-bottom: 1px solid var(--border);
  background: var(--bg-elevated);
}
.step-pill {
  padding: 22px 24px;
  cursor: pointer;
  border-right: 1px solid var(--border);
  position: relative;
  background: transparent;
  border-top: none;
  border-bottom: none;
  border-left: none;
  text-align: left;
  font-family: inherit;
  color: var(--text);
  transition: background-color 0.2s ease;
}
.step-pill:last-child { border-right: none; }
.step-pill:hover { background: var(--surface-2); }
.step-pill.active { background: var(--surface-2); }
.step-pill.active::after {
  content: "";
  position: absolute;
  bottom: -1px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--accent);
}
.step-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.12em;
  color: var(--text-dim);
  text-transform: uppercase;
  display: block;
  margin-bottom: 8px;
  transition: color 0.2s ease;
}
.step-pill.active .step-num { color: var(--accent); }
.step-title-short {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.25;
}
.stepper-stage {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 340px;
}
.stage-text {
  padding: 48px 44px;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.stage-text h3 {
  font-family: 'Fraunces', serif;
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.015em;
  line-height: 1.2;
  margin-bottom: 18px;
  color: var(--text);
}
.stage-text p {
  color: var(--text-muted);
  font-size: 16px;
  line-height: 1.65;
}
.stage-text .step-meta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accent);
  margin-bottom: 16px;
}

.stage-visual {
  padding: 48px 44px;
  background: var(--bg-elevated);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* Visual panels for each step */
.visual-panel {
  display: none;
  width: 100%;
  max-width: 320px;
}
.visual-panel.active {
  display: block;
  animation: fadeScale 0.4s ease;
}

/* Step 1 — incoming call */
.call-card {
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 14px;
  padding: 22px;
  box-shadow: var(--shadow);
}
.call-head {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 18px;
}
.call-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  background: var(--accent-soft);
  color: var(--accent);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-family: 'JetBrains Mono', monospace;
  font-weight: 600;
  font-size: 14px;
  border: 1px solid var(--accent-border);
}
.call-info { flex: 1; }
.call-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 2px;
}
.call-meta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--text-muted);
}
.call-status {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--success);
  letter-spacing: 0.05em;
}
.call-status .dot {
  width: 6px; height: 6px;
  background: var(--success);
  border-radius: 50%;
  animation: pulse 1.4s ease-out infinite;
}
.call-line {
  height: 32px;
  display: flex;
  align-items: end;
  gap: 3px;
  margin-top: 12px;
}
.call-line .bar {
  flex: 1;
  background: var(--accent);
  border-radius: 1px;
  opacity: 0.7;
  animation: wave 1.2s ease-in-out infinite;
}
.call-line .bar:nth-child(2) { animation-delay: 0.1s; }
.call-line .bar:nth-child(3) { animation-delay: 0.2s; }
.call-line .bar:nth-child(4) { animation-delay: 0.3s; }
.call-line .bar:nth-child(5) { animation-delay: 0.4s; }
.call-line .bar:nth-child(6) { animation-delay: 0.5s; }
.call-line .bar:nth-child(7) { animation-delay: 0.6s; }
.call-line .bar:nth-child(8) { animation-delay: 0.7s; }
.call-line .bar:nth-child(9) { animation-delay: 0.8s; }
.call-line .bar:nth-child(10) { animation-delay: 0.9s; }
.call-line .bar:nth-child(11) { animation-delay: 1.0s; }
.call-line .bar:nth-child(12) { animation-delay: 1.1s; }

/* Step 2 — inventory check */
.inv-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8px;
}
.inv-item {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 14px;
  font-family: 'JetBrains Mono', monospace;
}
.inv-item.match { border-color: var(--accent); background: var(--accent-soft); }
.inv-tag {
  font-size: 10px;
  color: var(--text-muted);
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}
.inv-item.match .inv-tag { color: var(--accent); }
.inv-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 2px;
  font-family: 'IBM Plex Sans', sans-serif;
}
.inv-detail { font-size: 11px; color: var(--text-muted); }

/* Step 3 — alternative suggestion */
.suggest-card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 18px;
  margin-bottom: 10px;
}
.suggest-card.highlight {
  border-color: var(--accent);
  background: var(--accent-soft);
  position: relative;
}
.suggest-card.highlight::before {
  content: "RECOMMENDED";
  position: absolute;
  top: -8px;
  right: 14px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 9px;
  background: var(--accent);
  color: #0a0c10;
  padding: 3px 8px;
  border-radius: 4px;
  letter-spacing: 0.1em;
}
.suggest-title { font-weight: 600; font-size: 14px; margin-bottom: 4px; color: var(--text); }
.suggest-meta { font-family: 'JetBrains Mono', monospace; font-size: 11px; color: var(--text-muted); }
.suggest-card.highlight .suggest-meta { color: var(--accent); }

/* Step 4 — booked */
.booking-card {
  background: var(--surface);
  border: 1px solid var(--border-strong);
  border-radius: 14px;
  padding: 22px;
}
.booking-status {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(74, 222, 128, 0.12);
  color: var(--success);
  padding: 4px 10px;
  border-radius: 100px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.booking-title {
  font-family: 'Fraunces', serif;
  font-size: 18px;
  font-weight: 500;
  margin-bottom: 10px;
}
.booking-detail {
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-muted);
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
  border-top: 1px solid var(--border);
}
.booking-detail:first-of-type { border-top: none; padding-top: 0; }
.booking-detail span:last-child { color: var(--text); font-weight: 500; }

/* ============================================================
   DEMO CONVERSATION
   ============================================================ */
.demo { border-top: 1px solid var(--border); }
.demo-shell {
  display: grid;
  grid-template-columns: 1fr 1.3fr;
  gap: 60px;
  align-items: center;
}
.demo-copy h2 { margin-bottom: 20px; }
.demo-copy p {
  color: var(--text-muted);
  font-size: 17px;
  line-height: 1.65;
  margin-bottom: 18px;
}
.demo-copy ul {
  list-style: none;
  margin-top: 24px;
}
.demo-copy li {
  padding: 10px 0;
  border-top: 1px solid var(--border);
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 14px;
  color: var(--text-muted);
}
.demo-copy li:last-child { border-bottom: 1px solid var(--border); }
.demo-copy li svg { width: 14px; height: 14px; color: var(--accent); flex-shrink: 0; }

.chat-window {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  overflow: hidden;
  box-shadow: var(--shadow);
}
.chat-header {
  padding: 14px 18px;
  border-bottom: 1px solid var(--border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-elevated);
}
.chat-id {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 12px;
  color: var(--text-muted);
}
.chat-id .dot {
  width: 8px; height: 8px;
  background: var(--success);
  border-radius: 50%;
}
.chat-replay {
  background: transparent;
  border: 1px solid var(--border);
  color: var(--text-muted);
  padding: 4px 10px;
  border-radius: 6px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  cursor: pointer;
  letter-spacing: 0.05em;
  transition: color 0.15s ease, border-color 0.15s ease;
}
.chat-replay:hover { color: var(--text); border-color: var(--text-dim); }

.chat-body {
  padding: 22px;
  min-height: 420px;
  max-height: 480px;
  overflow-y: auto;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
