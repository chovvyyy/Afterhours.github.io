     ============================================================ -->
<script>
(function() {
  'use strict';

  // ===== Theme toggle =====
  const themeToggle = document.getElementById('themeToggle');
  const stored = localStorage.getItem('theme');
  const preferDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
  const initial = stored || (preferDark ? 'dark' : 'light');
  document.documentElement.setAttribute('data-theme', initial);

  themeToggle.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme');
    const next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
  });

  // ===== Sticky nav border on scroll =====
  const nav = document.getElementById('nav');
  const onScroll = () => {
    if (window.scrollY > 8) nav.classList.add('scrolled');
    else nav.classList.remove('scrolled');
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // ===== Reveal on scroll =====
  const revealEls = document.querySelectorAll('.reveal');
  const revealObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('in');
        revealObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
  revealEls.forEach(el => revealObs.observe(el));

  // ===== Animated counters =====
  const counters = document.querySelectorAll('[data-counter]');
  const counterObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const el = e.target;
        const target = parseInt(el.getAttribute('data-counter'), 10);
        const suffix = el.getAttribute('data-suffix') || '';
        const duration = 1400;
        const start = performance.now();
        const initialVal = 0;
        function tick(now) {
          const elapsed = now - start;
          const progress = Math.min(elapsed / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          const val = Math.round(initialVal + (target - initialVal) * eased);
          el.textContent = val + suffix;
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
        counterObs.unobserve(el);
      }
    });
  }, { threshold: 0.4 });
  counters.forEach(c => counterObs.observe(c));

  // ===== Interactive stepper =====
  const pills = document.querySelectorAll('.step-pill');
  const contents = document.querySelectorAll('.step-content');
  const visuals = document.querySelectorAll('.visual-panel');
  let activeStep = 1;
  let autoplayTimer = null;
  let userInteracted = false;

  function setStep(n) {
    activeStep = n;
    pills.forEach(p => {
      p.classList.toggle('active', parseInt(p.getAttribute('data-step'), 10) === n);
    });
    contents.forEach(c => {
      const match = parseInt(c.getAttribute('data-content'), 10) === n;
      c.style.display = match ? 'block' : 'none';
      if (match) {
        c.style.animation = 'none';
        c.offsetHeight; // force reflow
        c.style.animation = 'fadeScale 0.4s ease';
      }
    });
    visuals.forEach(v => {
      v.classList.toggle('active', parseInt(v.getAttribute('data-visual'), 10) === n);
    });
  }

  pills.forEach(p => {
    p.addEventListener('click', () => {
      userInteracted = true;
      if (autoplayTimer) { clearInterval(autoplayTimer); autoplayTimer = null; }
      setStep(parseInt(p.getAttribute('data-step'), 10));
    });
  });

  // Autoplay until user interacts
  const howSection = document.getElementById('how');
  const howObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting && !userInteracted && !autoplayTimer) {
        autoplayTimer = setInterval(() => {
          if (userInteracted) { clearInterval(autoplayTimer); autoplayTimer = null; return; }
          const next = activeStep >= 4 ? 1 : activeStep + 1;
          setStep(next);
        }, 4200);
      }
    });
  }, { threshold: 0.3 });
  howObs.observe(howSection);

  // ===== Chat demo simulation =====
  const chatBody = document.getElementById('chatBody');
  const chatReplay = document.getElementById('chatReplay');

  const conversation = [
    { who: 'customer', text: 'Hi, do you have any Toyota RAV4s available?', delay: 600 },
    { who: 'ai', typing: 1400, text: "Hi! Yes — we currently have 6 RAV4s on the lot, ranging from the LE at $29,800 to the Limited at $38,500. Are you looking for a specific trim or color?", delay: 800 },
    { who: 'customer', text: 'Something around $32k, good on gas if possible.', delay: 700 },
    { who: 'ai', typing: 1500, text: "Great — I'd suggest the 2024 RAV4 Hybrid LE at $32,400. It gets 41 mpg combined and we have one on the lot right now in Magnetic Gray. Want to come see it?", delay: 700 },
    { who: 'customer', text: 'Yes that sounds perfect. Can I come tomorrow morning?', delay: 600 },
    { who: 'ai', typing: 1200, text: "Absolutely. I have 10:30 AM open with Mike, one of our senior reps. Can I get your name and a phone number to confirm?", delay: 700 },
    { who: 'customer', text: 'Jordan Marshall, 555-0184.', delay: 500 },
    { who: 'ai', typing: 1100, text: "Booked, Jordan! You're confirmed for tomorrow at 10:30 AM. I'll send a text reminder to 555-0184. See you then!", delay: 600 },
    { result: true, delay: 500 }
  ];

  function clearChat() { chatBody.innerHTML = ''; }

  function appendMessage(who, text) {
    const div = document.createElement('div');
    div.className = 'chat-msg ' + who;
    div.innerHTML = '<span class="sender">' + (who === 'customer' ? 'CUSTOMER' : 'AFTERHOURS AI') + '</span>' + text;
    chatBody.appendChild(div);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  function appendTyping() {
    const div = document.createElement('div');
    div.className = 'chat-typing';
    div.id = 'typing';
    div.innerHTML = '<span></span><span></span><span></span>';
    chatBody.appendChild(div);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  function removeTyping() {
    const t = document.getElementById('typing');
    if (t) t.remove();
  }

  function appendResult() {
    const div = document.createElement('div');
    div.className = 'chat-result';
    div.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg><div class="result-text"><strong>LEAD CAPTURED · APPOINTMENT BOOKED</strong><br>Jordan Marshall · Test drive 10:30 AM tomorrow · Recording sent to your team</div>';
    chatBody.appendChild(div);
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  let demoRunning = false;
  async function playDemo() {
    if (demoRunning) return;
    demoRunning = true;
    clearChat();
    for (const step of conversation) {
      if (step.result) {
        await wait(step.delay);
        appendResult();
        continue;
      }
      if (step.typing) {
        await wait(step.delay);
        appendTyping();
        await wait(step.typing);
        removeTyping();
      } else {
        await wait(step.delay);
      }
      appendMessage(step.who, step.text);
    }
    demoRunning = false;
  }

  function wait(ms) { return new Promise(r => setTimeout(r, ms)); }

  chatReplay.addEventListener('click', () => { if (!demoRunning) playDemo(); });

  const demoSection = document.getElementById('demo');
  const demoObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        playDemo();
        demoObs.unobserve(demoSection);
      }
    });
  }, { threshold: 0.3 });
  demoObs.observe(demoSection);

  // ===== FAQ accordion =====
  document.querySelectorAll('.faq-item').forEach(item => {
    const q = item.querySelector('.faq-q');
    q.addEventListener('click', () => {
      const wasOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!wasOpen) item.classList.add('open');
    });
  });

})();
</script>

